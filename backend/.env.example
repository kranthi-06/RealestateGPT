# RealEstateGPT Backend Environment Variables
# Copy this to .env and fill in your values

# Database (MongoDB Atlas or a managed MongoDB deployment)
MONGODB_URI=
MONGODB_DATABASE=realestate_gpt

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App
APP_NAME=RealEstateGPT
APP_ENV=development
DEBUG=true

# AI gateway (backend only; never create NEXT_PUBLIC_GROQ_API_KEY)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1200
MAX_AGENT_STEPS=3
MAX_TOOL_CALLS=5
AI_RATE_LIMIT_REQUESTS=12
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Location intelligence (production default: no Google account or billing required)
LOCATION_PROVIDER=osm
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org
# Set this to an application identifier and monitored contact before production.
NOMINATIM_USER_AGENT=RealEstateGPT/1.0
OSM_TIMEOUT_SECONDS=15

# Optional future provider. Leave disabled unless Google Maps is intentionally selected.
MAPS_PROVIDER=none
GOOGLE_MAPS_SERVER_KEY=

# Storage (Phase 5)
# STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Redis (Phase 6)
# REDIS_URL=redis://localhost:6379/0
