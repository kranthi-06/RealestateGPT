# RealEstateGPT Backend Environment Variables
# Copy this to .env and fill in your values

# Database (MongoDB Atlas or a managed MongoDB deployment)
MONGODB_URI=
MONGODB_DATABASE=realestate_gpt

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS
#   The deployed frontend origin must be listed. Loopback origins are only for
#   local development and are dropped automatically when APP_ENV != development.
#
#   IMPORTANT: set this in the real backend environment, not in this example
#   file. Example value only:
CORS_ORIGINS=https://realestate-gpt-inky.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# App
APP_NAME=RealEstateGPT
APP_ENV=production
DEBUG=false

# AI gateway (backend only; never create NEXT_PUBLIC_GROQ_API_KEY)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1200
MAX_AGENT_STEPS=3
MAX_TOOL_CALLS=5
AI_RATE_LIMIT_REQUESTS=12
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Location intelligence (production default: no Google account or billing required)
LOCATION_PROVIDER=osm
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org
# Set this to an application identifier and monitored contact before production.
NOMINATIM_USER_AGENT=RealEstateGPT/1.0
OSM_TIMEOUT_SECONDS=15

# Web search / property discovery (authorized Web Search API, never scraping)
#   All keys below are server-side. NEVER create NEXT_PUBLIC_BRAVE_SEARCH_API_KEY.
WEB_DISCOVERY_ENABLED=true
# Provider selection: "searxng" (self-hosted, no API key needed) or
# "brave" (requires BRAVE_SEARCH_API_KEY).
WEB_SEARCH_PROVIDER=searxng
BRAVE_SEARCH_API_KEY=
# Required when WEB_SEARCH_PROVIDER=searxng.
#   Local development: the Docker instance in infra/searxng.
#   Deployed (any APP_ENV other than development): a PUBLICLY REACHABLE
#   https SearXNG host. A loopback URL is rejected outside development and web
#   discovery then reports WEB_SEARCH_NOT_CONFIGURED instead of silently
#   depending on your laptop. See infra/searxng/README.md.
#
#   IMPORTANT: do NOT commit a real production SearXNG URL here. Set it only in
#   the real environment configuration for the deployed backend.
SEARXNG_BASE_URL=
# Optional shared bearer token for a reverse-proxy-protected SearXNG instance.
#   The production image in infra/searxng enforces "Authorization: Bearer
#   <token>" at its Caddy edge; set the SAME value on both sides (here and via
#   `flyctl secrets set SEARXNG_AUTH_TOKEN=...`). Leave empty for an
#   unprotected local dev instance. Server-side only — never NEXT_PUBLIC_.
SEARXNG_AUTH_TOKEN=
WEB_SEARCH_COUNTRY=IN
WEB_SEARCH_LANGUAGE=en
WEB_SEARCH_MAX_QUERIES=3
WEB_SEARCH_MAX_RESULTS=20
WEB_SEARCH_CACHE_TTL_SECONDS=300
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RETRIES=2
WEB_SEARCH_RPM=
WEB_SEARCH_CONCURRENCY=2
WEB_DISCOVERY_OSM_ENRICH_LIMIT=10
WEB_SEARCH_ALLOWED_DOMAINS=
PAGE_ENRICHMENT_ENABLED=false

# Property data providers (production inventory REQUIRES a licensed provider)
#   ""            = no provider configured -> inventory stays empty, UI explains
#   admin_import  = platform admin imports an authored record file (no scraping)
PROPERTY_PROVIDER=
PROPERTY_PROVIDER_FILE=./data/property_provider.jsonl
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_RETRIES=2
PROVIDER_MIN_INTERVAL_SECONDS=0.5
INGESTION_BATCH_SIZE=50
INGESTION_MAX_PAGES=20

# Worker scheduler + freshness lifecycle
#   Cron can trigger POST /api/v1/workers/run/{name} with this header value:
#   X-Worker-Secret: <WORKER_RUN_SECRET>
WORKER_RUN_SECRET=change-this-worker-secret-in-production
# Required by Vercel Cron. Vercel sends this as Authorization: Bearer
# <CRON_SECRET>; keep it server-only and use a distinct long random value.
CRON_SECRET=
WORKER_LOCK_TTL_SECONDS=900
LISTING_STALE_AFTER_HOURS=72
LISTING_EXPIRE_AFTER_DAYS=21

# Optional future provider. Leave disabled unless Google Maps is intentionally selected.
MAPS_PROVIDER=none
GOOGLE_MAPS_SERVER_KEY=

# Storage (Phase 5)
# STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Redis (Phase 6)
# REDIS_URL=redis://localhost:6379/0
