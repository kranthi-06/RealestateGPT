# RealEstateGPT Backend Environment Variables
# Copy this to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./realestate_gpt.db
# For PostgreSQL: postgresql://user:password@localhost:5432/realestate_gpt

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# App
APP_NAME=RealEstateGPT
APP_ENV=development
DEBUG=true

# AI (Phase 2)
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o

# Google Maps Platform (Slice 2/3)
# Enable Maps JavaScript API, Places API (New), Geocoding API and Routes API.
# Use a server-restricted key here. Never put this key in the frontend.
MAPS_PROVIDER=none
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_TIMEOUT_SECONDS=10

# Storage (Phase 5)
# STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Redis (Phase 6)
# REDIS_URL=redis://localhost:6379/0
