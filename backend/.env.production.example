# RealEstateGPT - BACKEND production environment (TEMPLATE ONLY)
# =====================================================================
# Location of the REAL values: Vercel project `realestate-gpt`,
#   Settings -> Environment Variables (service: backend).
# This file contains NO real secrets. Placeholders tell you where the
# value lives so you never have to hunt for it.
#   <SET_IN_VERCEL>        already configured in Vercel - do not change
#   <SET_IN_FLY>           created as a Fly.io secret (SearXNG container)
#   <SET_IN_FLY_AND_VERCEL> exists in BOTH, must be identical in both
#   <MUST_BE_true>         literal value must be `true`
# =====================================================================

# --- Application -----------------------------------------------------
APP_NAME=RealEstateGPT
APP_ENV=production
DEBUG=false

# --- MongoDB Atlas ---------------------------------------------------
MONGODB_URI=<SET_IN_VERCEL>
MONGODB_DATABASE=realestate_gpt
MONGODB_MAX_POOL_SIZE=20
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=30000

# --- Security / auth -------------------------------------------------
SECRET_KEY=<SET_IN_VERCEL>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ------------------------------------------------------------
CORS_ORIGINS=https://realestate-gpt-inky.vercel.app
PRODUCTION_FRONTEND_URL=https://realestate-gpt-inky.vercel.app

# --- Rate limiting ---------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10

# --- AI gateway (Groq, server-side only) -----------------------------
AI_PROVIDER=groq
GROQ_API_KEY=<SET_IN_VERCEL>
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1200
MAX_AGENT_STEPS=3
MAX_TOOL_CALLS=5
AI_RATE_LIMIT_REQUESTS=12
AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- Location (OpenStreetMap: no account, no billing) ---------------
LOCATION_PROVIDER=osm
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.org/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_USER_AGENT=RealEstateGPT/1.0
OSM_TIMEOUT_SECONDS=15
MAPS_PROVIDER=none

# --- Web discovery (the activation block) ----------------------------
# Provider "tavily": backend-only REST integration with Tavily. The key is
# sent as an Authorization header from the FastAPI service and must never be
# exposed to the browser (never NEXT_PUBLIC_TAVILY_API_KEY).
WEB_DISCOVERY_ENABLED=<MUST_BE_true>
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=<SET_IN_VERCEL>                    # server-side only, never print
TAVILY_SEARCH_DEPTH=basic                         # 1 credit/request (free tier: 1000/mo)
# Optional alternates (unused while WEB_SEARCH_PROVIDER=tavily):
# BRAVE_SEARCH_API_KEY=<SET_IN_VERCEL>
# SEARXNG_BASE_URL=<ACTUAL_FLY_HTTPS_URL>          # needs Fly.io billing
# SEARXNG_AUTH_TOKEN=<SET_IN_FLY_AND_VERCEL>
WEB_SEARCH_COUNTRY=IN
WEB_SEARCH_LANGUAGE=en
WEB_SEARCH_MAX_QUERIES=3
WEB_SEARCH_MAX_RESULTS=20
WEB_SEARCH_CACHE_TTL_SECONDS=300
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RETRIES=2
WEB_SEARCH_CONCURRENCY=2
WEB_DISCOVERY_OSM_ENRICH_LIMIT=10
PAGE_ENRICHMENT_ENABLED=false
# WEB_SEARCH_RPM=60                     # optional (default 60)
# WEB_SEARCH_ALLOWED_DOMAINS=           # optional (empty = unrestricted)
# BRAVE_SEARCH_API_KEY=                 # unused while provider=searxng

# --- Property inventory (unset = honest empty catalogue) -------------
# PROPERTY_PROVIDER=admin_import        # only with curated, licensed records
PROPERTY_PROVIDER_FILE=./data/property_provider.jsonl
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_RETRIES=2
PROVIDER_MIN_INTERVAL_SECONDS=0.5
INGESTION_BATCH_SIZE=50
INGESTION_MAX_PAGES=20

# --- Workers / cron (server-side secrets) ----------------------------
WORKER_RUN_SECRET=<SET_IN_VERCEL>
CRON_SECRET=<SET_IN_VERCEL>
WORKER_LOCK_TTL_SECONDS=900
LISTING_STALE_AFTER_HOURS=72
LISTING_EXPIRE_AFTER_DAYS=21
