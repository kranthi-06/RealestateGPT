# Vercel CLI upload exclusions for `vercel --prod`.
# Nothing listed here is needed by the build: Vercel installs dependencies and
# builds from source. Keeps local secrets and multi-hundred-MB artifacts out
# of the deployment archive.

# Vercel's own state
.vercel
.vercelignore

# Local secrets / per-developer environment (server secrets come from the
# Vercel dashboard, never from a file in the upload)
.env
.env.local
.env.*
backend/.env
backend/.env.*
frontend/.env.local
vercel.env
vercel.env.example

# Regenerated by the build itself
**/node_modules
**/.next
**/.venv
**/venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/*.log

# Not part of the runtime deployment
docs/
infra/
migration_backup/
.github/
.kilo/
frontend/e2e/
frontend/test-results/
frontend/playwright-report/
frontend/*.log
