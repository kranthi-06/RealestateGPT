# ============================================================
# RealEstateGPT - Vercel environment (copy-paste ready)
# ============================================================
# 1) Fill in the MongoDB Atlas values below.
# 2) Copy the BACKEND block into Vercel -> Project -> Settings
#    -> Environment Variables, assigned to the "Backend" service.
# 3) Copy the FRONTEND block into the "Frontend" service.
# Copy this file to vercel.env (gitignored) and fill real values.
#
# IMPORTANT: nothing in this file may point at a developer machine. Loopback
# origins/URLs are rejected outside development, and the frontend build never
# falls back to localhost.

# ------------------------------------------------------------
# BACKEND service (FastAPI)
# ------------------------------------------------------------
MONGODB_URI=
MONGODB_DATABASE=realestate_gpt
MONGODB_MAX_POOL_SIZE=20
SECRET_KEY=<generate-with: openssl rand -hex 32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_NAME=RealEstateGPT
APP_ENV=production
DEBUG=false

# The deployed frontend origin. Loopback origins are accepted here only while
# APP_ENV=development; in production they are dropped automatically.
CORS_ORIGINS=https://realestate-gpt-inky.vercel.app
PRODUCTION_FRONTEND_URL=https://realestate-gpt-inky.vercel.app

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_REQUESTS=10

# Real Groq AI gateway (backend only; do not use a NEXT_PUBLIC_ key)
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=1200
MAX_AGENT_STEPS=3
MAX_TOOL_CALLS=5
AI_RATE_LIMIT_REQUESTS=12
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Web search / property discovery (server-side only; do not use NEXT_PUBLIC_ keys)
# Provider: "searxng" (self-hosted, no key) or "brave" (needs BRAVE_SEARCH_API_KEY).
#   - SEARXNG_BASE_URL MUST be a publicly reachable https host. Deploy one with
#     infra/searxng/ (see infra/searxng/README.md) on Fly.io / Render / Railway,
#     or point this at your own hosted instance. Never use http://localhost:8080.
WEB_DISCOVERY_ENABLED=true
WEB_SEARCH_PROVIDER=searxng
BRAVE_SEARCH_API_KEY=
SEARXNG_BASE_URL=
WEB_SEARCH_COUNTRY=IN
WEB_SEARCH_LANGUAGE=en
WEB_SEARCH_MAX_QUERIES=3
WEB_SEARCH_MAX_RESULTS=20
WEB_SEARCH_CACHE_TTL_SECONDS=300
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RETRIES=2
WEB_SEARCH_RPM=
WEB_SEARCH_CONCURRENCY=2
WEB_DISCOVERY_OSM_ENRICH_LIMIT=10
WEB_SEARCH_ALLOWED_DOMAINS=
PAGE_ENRICHMENT_ENABLED=false

# Property inventory. Production listings require a licensed/authorized provider
# (see backend/app/providers/property/). Leave empty to keep the catalogue empty
# and honest instead of showing demo data as real inventory.
PROPERTY_PROVIDER=
PROPERTY_PROVIDER_FILE=./data/property_provider.jsonl

# Workers. Scheduled jobs authenticate with X-Worker-Secret: <WORKER_RUN_SECRET>
# against POST /api/v1/workers/run/{name}. Generate a long random value with
# `openssl rand -hex 32` and add the same value to the GitHub repository secret
# WORKER_RUN_SECRET so .github/workflows/workers.yml can schedule the runs.
WORKER_RUN_SECRET=
# Required by the Vercel Cron paths in vercel.json. Vercel sends this as
# Authorization: Bearer <CRON_SECRET>; never expose it to the frontend.
CRON_SECRET=
WORKER_LOCK_TTL_SECONDS=900
LISTING_STALE_AFTER_HOURS=72
LISTING_EXPIRE_AFTER_DAYS=21

# Production location provider: OpenStreetMap, Nominatim, Overpass and OSRM.
# Google Maps is optional and is not required for the production path.
LOCATION_PROVIDER=osm
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_BASE_URL=https://router.project-osrm.org
# Set this to a monitored application identifier before production.
NOMINATIM_USER_AGENT=RealEstateGPT/1.0 (contact: you@example.com)
OSM_TIMEOUT_SECONDS=15
MAPS_PROVIDER=none

# ------------------------------------------------------------
# FRONTEND service (Next.js)
# ------------------------------------------------------------
# Same-origin path served by the backend service (see vercel.json rewrites).
NEXT_PUBLIC_API_URL=https://realestate-gpt-inky.vercel.app/api/backend
# Canonical/OG/robots/sitemap origin.
NEXT_PUBLIC_SITE_URL=https://realestate-gpt-inky.vercel.app
# No Maps API key is required for Leaflet + OpenStreetMap.
