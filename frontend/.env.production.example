# RealEstateGPT - FRONTEND production environment (TEMPLATE ONLY)
# =====================================================================
# Location of the REAL values: Vercel project `realestate-gpt`,
#   Settings -> Environment Variables.
# NEXT_PUBLIC_* values are compiled into the browser bundle: they must
# only ever be public URLs. No secret may ever be added here.
# =====================================================================

# Same-origin path served by the backend service (see vercel.json rewrites).
NEXT_PUBLIC_API_URL=https://realestate-gpt-inky.vercel.app/api/backend

# Canonical origin (OG / robots / sitemap).
NEXT_PUBLIC_SITE_URL=https://realestate-gpt-inky.vercel.app

# Explicitly NOT set on the frontend, ever:
# NEXT_PUBLIC_SECRET_KEY=
# NEXT_PUBLIC_GROQ_API_KEY=
# NEXT_PUBLIC_MONGODB_URI=
# NEXT_PUBLIC_CRON_SECRET=
# NEXT_PUBLIC_WORKER_RUN_SECRET=
# NEXT_PUBLIC_SEARXNG_AUTH_TOKEN=
# NEXT_PUBLIC_SEARXNG_BASE_URL=        # backend-only configuration
